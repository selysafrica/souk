# Souk — configuration du serveur. Copier en .env (jamais versionné).
APP_DOMAIN=souk.selys.app

# Préproduction (serveur de développement Selys, branche pprod) : cette ligne à la place.
# APP_DOMAIN=souk-pprod.selys.app

# Mot de passe de l'administration (/admin). Long et unique : openssl rand -base64 24
ADMIN_PASSWORD=

# Port local de l'application sur le serveur (127.0.0.1 uniquement).
# 4310 pour ne pas croiser BeaEvent (4300) sur le même serveur.
APP_PORT=4310

# ─── Exposition HTTPS : une seule option ───

# B (par défaut). Nginx installé sur le serveur, qui termine le TLS avec certbot :
#    aucune ligne à ajouter ici ; installer deploy/nginx.conf (voir l'en-tête du fichier).

# A. Reverse proxy Docker déjà en place sur 80/443 : il joint l'application sur souk:4000.
# COMPOSE_FILE=docker-compose.yml:deploy/proxy-network.yml
# PROXY_NETWORK=selys

# C. Serveur vierge (80/443 libres) : Caddy dédié avec certificat automatique.
# COMPOSE_FILE=docker-compose.yml:deploy/caddy.yml
# ACME_EMAIL=
